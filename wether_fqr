#!/bin/bash

# Очищаем экран для красоты
clear

# 1. Приветствие (выведет: Привет, belousovnm!)
echo -e "\e[1;36mПривет, $USER! Добро пожаловать в терминал.\e[0m"
# Делаем название дня недели с большой буквы
day_now=$(date +'%A')
day_capitalized="${day_now^}"
echo -e "Сегодня: \e[1;33m$day_capitalized, $(date +'%d %B %Y года')\e[0m"
echo -e "--------------------------------------------------------"

# 2. Погода в Мегионе
echo -e "\e[1;32mАктуальная погода в Мегионе:\e[0m"
curl -s "wttr.in/Megion?m&0"
echo -e "--------------------------------------------------------"

# 3. База цитат прямо внутри скрипта (можно дописывать свои!)
quotes=(
    "Если вы считаете, что Linux сложен, вам пора вернуться к Windows. — Линус Торвальдс"
    "Код никогда не врет, в отличие от комментариев."
    "Чтобы понять рекурсию, нужно сначала понять рекурсию."
    "Удачный день начинается не с кофе, а с успешно выполненного скрипта!"
    "В мире есть 10 типов людей: те, кто понимают двоичную систему, и те, кто нет."
    "Работает? Не трогай!"
    "Семь раз отмерь, один раз нажмите Enter."
    "Ошибки — это просто знаки препинания в коде жизни."
)

# Выбираем случайный индекс из массива цитат
rand_index=$((RANDOM % ${#quotes[@]}))

# Выводим мысль дня
echo -e "\e[1;35mМысль дня для хорошего настроения:\e[0m"
echo -e "${quotes[$rand_index]}"
echo -e "--------------------------------------------------------"


