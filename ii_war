#!/bin/bash

# Функция для имитации крутящегося барабана револьвера
visual_spin() {
    echo "--- КРУТИМ БАРАБАН ---"
    echo "[ O  O  O  O  O  O ]"
    sleep 0.3
    echo "[ X  O  O  O  O  O ]"
    sleep 0.3
    echo "[ O  X  O  O  O  O ]"
    sleep 0.3
    echo "[ O  O  X  O  O  O ]"
    sleep 0.3
    echo "----------------------"
}

# Функция для драматической паузы перед спуском курка
suspense() {
    local text="$1"
    echo -n "$text"
    for i in {1..3}; do
        sleep 0.8
        echo -n "."
    done
    echo ""
    sleep 0.9
}

# Функция жесткого падения терминала при проигрыше
explode_terminal() {
    echo ""
    echo "=========================================================="
    echo "     [ Б А Х ! ]  П А Т Р О Н  Б Ы Л  В  Я Ч Е Й К Е .    "
    echo "=========================================================="
    sleep 1

    # Отключаем ввод с клавиатуры, чтобы сломать управление
   #stty -echo
    
    # Заливаем экран бесконечным потоком буквенного хаоса без спецкодов
    while true; do
        echo "СБОЙ СИСТЕМЫ ОШИБКА КРИТИЧЕСКИЙ УРОН ПРОИГРЫШ КИБЕР-СМЕРТЬ $((RANDOM))"
        sleep 0.01
    done
}

clear
echo "=========================================================="
echo "          CYBER PUNK ROULETTE: TEXT EDITION v3.0          "
echo "=========================================================="
#echo " Мы убрали все цветные коды. Только чистый текст без ошибок."
echo " Заряжен 1 патрон из 6."
echo ""

# Инициализация барабана (0 - пусто, 1 - патрон)
chamber=(0 0 0 0 0 0)
bullet_slot=$((RANDOM % 6))
chamber[$bullet_slot]=1

current_shot=0
player_turn=$((RANDOM % 2))

while [ $current_shot -lt 6 ]; do
    if [ $player_turn -eq 1 ]; then
        echo ">>> ВАШ ХОД. Нажмите [Enter], чтобы спустить курок..."
        read -s
        
        visual_spin
        suspense "[!] Вы нажимаете на спусковой крючок"
        
        if [ ${chamber[$current_shot]} -eq 1 ]; then
            explode_terminal
        else
            echo "[-] МЕТАЛЛИЧЕСКИЙ ЩЕЛЧОК! Ячейка пуста. Вы живы."
            echo "=========================================================="
        fi
        player_turn=0
    else
        echo ">>> ХОД РОБОТА. Компьютер берет револьвер..."
        sleep 1
        
        visual_spin
        suspense "[РОБОТ] Компьютер спускает курок"
        
        if [ ${chamber[$current_shot]} -eq 1 ]; then
            echo ""
            echo "[ПОБЕДА!] Револьвер разнес процессор ИИ! Робот повержен."
            echo "Вы победили компьютер в этой смертельной игре!"
            exit 0
        else
            echo "[-] МЕТАЛЛИЧЕСКИЙ ЩЕЛЧОК! Ячейка пуста. Робот продолжает игру."
            echo "=========================================================="
        fi
        player_turn=1
    fi
    
    current_shot=$((current_shot + 1))
done

